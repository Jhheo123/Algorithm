import sys
sys.stdin=open("./input.txt","r")
input = sys.stdin.readline
from collections import deque
def see_graph(graph):
    for i in graph:
        print(i)
n, m, v = map(int, input().split())
graph = [[0]*(n+1) for _ in range(n+1)]
# see_graph(graph)

for _ in range(m):
    a, b = map(int, input().split())
    graph[a][b] = graph[b][a] = 1

visited1 = [0]*(n+1)
visited2 = visited1.copy()

def dfs(v):
    visited1[v] = 1 # 방문표시
    print(v, end = ' ')
    for i in range(1, n+1):
        if graph[v][i] == 1 and visited1[i] == 0: # 미방문
            dfs(i)

def bfs(v):
    q = deque([v])
    visited2[v] = 1
    while q:
        vv = q.popleft()
        print(vv, end = ' ')
        for i in range(1, n+1):
            if graph[vv][i] == 1 and visited2[i] == 0:
                q.append(i)
                visited2[i] = 1
dfs(v)
print()
bfs(v)
